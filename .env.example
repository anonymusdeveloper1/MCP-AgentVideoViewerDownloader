# All optional - avv works with no configuration at all.
# Copy to .env only if you want to override the defaults.

# Where downloads land when the caller does not specify a directory.
AVV_DOWNLOAD_DIR=~/Downloads/avv

# Colon-separated roots that writes are confined to. Anything outside is refused.
# Defaults to your home directory, the system temp dir, and the avv cache.
# AVV_ALLOWED_ROOTS=/Users/you/media:/Volumes/Scratch

# Cache for provisioned binaries, Whisper models, and scratch files.
AVV_HOME=~/.avv

# Whisper model: tiny | base | small | medium | large-v3-turbo
# Downloaded automatically on first use. base is ~148 MB, large-v3-turbo ~1.6 GB.
AVV_WHISPER_MODEL=base

# Resource guards. These stop a confused agent filling your disk.
AVV_MAX_DURATION_SEC=14400
AVV_MAX_FILESIZE_MB=4096
AVV_MIN_FREE_DISK_MB=1024
AVV_MAX_FRAMES=64
AVV_TIMEOUT_SEC=1800

# Override binary discovery if the tools are not on PATH.
# AVV_FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# AVV_FFPROBE_PATH=/opt/homebrew/bin/ffprobe
# AVV_YTDLP_PATH=/opt/homebrew/bin/yt-dlp
# AVV_WHISPER_PATH=/opt/homebrew/bin/whisper-cli
