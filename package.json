{
  "name": "avv-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/core",
    "packages/mcp",
    "packages/cli"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo",
    "rebuild": "npm run clean && npm run build",
    "typecheck": "tsc --build --force",
    "doctor": "node packages/cli/dist/index.js doctor",
    "mcp": "node packages/mcp/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^5.9.3"
  }
}
